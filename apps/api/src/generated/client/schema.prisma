// Prisma schema for IAMS — Internal Audit Management System
// PostgreSQL datasource configured via DATABASE_URL env var.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Authentication & Authorization ----

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles UserRole[]

  ownedAuditEntities   AuditUniverse[] @relation("AuditUniverseOwner")
  createdAuditEntities AuditUniverse[] @relation("AuditUniverseCreator")
  updatedAuditEntities AuditUniverse[] @relation("AuditUniverseUpdater")

  ownedRisks      Risk[]       @relation("RiskOwner")
  createdRisks    Risk[]       @relation("RiskCreator")
  updatedRisks    Risk[]       @relation("RiskUpdater")
  assignedActions RiskAction[] @relation("RiskActionAssignee")

  approvedAuditPlans AuditPlan[] @relation("AuditPlanApprover")
  leadAuditPlans     AuditPlan[] @relation("AuditPlanLeadAuditor")
  createdAuditPlans  AuditPlan[] @relation("AuditPlanCreator")
  updatedAuditPlans  AuditPlan[] @relation("AuditPlanUpdater")

  leadEngagements       Engagement[]           @relation("EngagementLeadAuditor")
  createdEngagements    Engagement[]           @relation("EngagementCreator")
  updatedEngagements    Engagement[]           @relation("EngagementUpdater")
  closedEngagements     Engagement[]           @relation("EngagementClosedBy")
  engagementMemberships EngagementTeamMember[] @relation("EngagementTeamMember")

  createdFindings            Finding[] @relation("FindingCreator")
  updatedFindings            Finding[] @relation("FindingUpdater")
  responsibleFindings        Finding[] @relation("FindingResponsibleOwner")
  managementResponseFindings Finding[] @relation("FindingManagementResponder")
  verifiedFindings           Finding[] @relation("FindingVerifier")

  testedControlTests   ControlTest[] @relation("ControlTestTester")
  reviewedControlTests ControlTest[] @relation("ControlTestReviewer")
  createdControlTests  ControlTest[] @relation("ControlTestCreator")
  updatedControlTests  ControlTest[] @relation("ControlTestUpdater")

  responsibleActionPlans ActionPlan[]       @relation("ActionPlanResponsibleOwner")
  reviewerActionPlans    ActionPlan[]       @relation("ActionPlanReviewer")
  createdActionPlans     ActionPlan[]       @relation("ActionPlanCreator")
  updatedActionPlans     ActionPlan[]       @relation("ActionPlanUpdater")
  verifiedActionPlans    ActionPlan[]       @relation("ActionPlanVerifier")
  actionPlanUpdates      ActionPlanUpdate[] @relation("ActionPlanUpdateAuthor")

  submittedEvidence Evidence[] @relation("EvidenceSubmittedBy")
  reviewedEvidence  Evidence[] @relation("EvidenceReviewer")
  createdEvidence   Evidence[] @relation("EvidenceCreator")
  updatedEvidence   Evidence[] @relation("EvidenceUpdater")

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([name])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---- Audit Logging ----

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  category  String
  userId    String?  @db.Uuid
  ip        String?
  userAgent String?
  metadata  Json?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

// ---- Audit Universe ----

enum AuditEntityType {
  ORGANIZATION
  DIVISION
  DEPARTMENT
  PROCESS
  SUB_PROCESS
  SYSTEM
  PROJECT
  THIRD_PARTY
  LOCATION
}

enum AuditEntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model AuditUniverse {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique
  name            String
  description     String?
  entityType      AuditEntityType
  status          AuditEntityStatus @default(ACTIVE)
  parentId        String?           @db.Uuid
  businessProcess String?
  department      String?
  riskRating      String?
  notes           String?

  ownerId     String? @db.Uuid
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   AuditUniverse?  @relation("AuditUniverseHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AuditUniverse[] @relation("AuditUniverseHierarchy")

  owner     User? @relation("AuditUniverseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User? @relation("AuditUniverseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AuditUniverseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  risks        Risk[]
  auditPlans   AuditPlan[]
  engagements  Engagement[]
  findings     Finding[]
  controlTests ControlTest[]
  actionPlans  ActionPlan[]
  evidence     Evidence[]

  @@index([parentId])
  @@index([entityType])
  @@index([status])
  @@index([name])
  @@index([ownerId])
}

// ---- Risk Assessment ----

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  MONITORING
  CLOSED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model Risk {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  auditEntityId String  @db.Uuid

  // Inherent risk assessment
  inherentLikelihood Int       @default(1) // 1-5 scale
  inherentImpact     Int       @default(1) // 1-5 scale
  inherentScore      Int       @default(1) // likelihood * impact
  inherentLevel      RiskLevel @default(LOW)

  // Existing controls assessment
  existingControls     String?
  controlEffectiveness Int     @default(0) // 0-100 percentage

  // Residual risk (calculated)
  residualScore Int       @default(1)
  residualLevel RiskLevel @default(LOW)

  status       RiskStatus @default(OPEN)
  riskCategory String?
  notes        String?

  ownerId     String? @db.Uuid
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Cascade)
  owner       User?         @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("RiskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("RiskUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  actions      RiskAction[]
  auditPlans   AuditPlan[]   @relation("AuditPlanRisk")
  engagements  Engagement[]  @relation("EngagementRisk")
  controlTests ControlTest[] @relation("ControlTestRisk")

  @@index([auditEntityId])
  @@index([status])
  @@index([inherentLevel])
  @@index([residualLevel])
  @@index([ownerId])
  @@index([title])
}

model RiskAction {
  id          String       @id @default(uuid()) @db.Uuid
  riskId      String       @db.Uuid
  title       String
  description String?
  assigneeId  String?      @db.Uuid
  dueDate     DateTime?
  completedAt DateTime?
  status      ActionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  risk     Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assignee User? @relation("RiskActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([riskId])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
}

// ---- Audit Planning ----

enum AuditPlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model AuditPlan {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  reference     String  @unique
  fiscalYear    Int
  auditEntityId String  @db.Uuid
  riskId        String? @db.Uuid

  objectives String
  scope      String
  priority   AuditPriority   @default(MEDIUM)
  status     AuditPlanStatus @default(DRAFT)

  estimatedResources String?
  planningRationale  String?

  proposedStartDate DateTime?
  proposedEndDate   DateTime?
  approvedAt        DateTime?
  approvedById      String?   @db.Uuid

  leadAuditorId String? @db.Uuid
  notes         String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Restrict)
  risk        Risk?         @relation("AuditPlanRisk", fields: [riskId], references: [id], onDelete: SetNull)
  approvedBy  User?         @relation("AuditPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  leadAuditor User?         @relation("AuditPlanLeadAuditor", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("AuditPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("AuditPlanUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  engagements Engagement[]

  @@index([auditEntityId])
  @@index([riskId])
  @@index([status])
  @@index([priority])
  @@index([fiscalYear])
  @@index([leadAuditorId])
  @@index([title])
}

// ---- Audit Engagements ----

enum EngagementStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum EngagementType {
  INTERNAL_AUDIT
  COMPLIANCE_AUDIT
  IT_AUDIT
  OPERATIONAL_AUDIT
  FINANCIAL_AUDIT
  FOLLOW_UP
  SPECIAL_REVIEW
  AD_HOC
}

model Engagement {
  id            String  @id @default(uuid()) @db.Uuid
  reference     String  @unique
  title         String
  auditPlanId   String? @db.Uuid
  auditEntityId String  @db.Uuid
  riskId        String? @db.Uuid

  type   EngagementType   @default(INTERNAL_AUDIT)
  status EngagementStatus @default(PLANNED)

  objectives  String
  scope       String
  methodology String?

  estimatedResources String?

  leadAuditorId   String?   @db.Uuid
  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  closedAt        DateTime?
  closedById      String?   @db.Uuid
  closureNotes    String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditPlan   AuditPlan?    @relation(fields: [auditPlanId], references: [id], onDelete: SetNull)
  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Restrict)
  risk        Risk?         @relation("EngagementRisk", fields: [riskId], references: [id], onDelete: SetNull)
  leadAuditor User?         @relation("EngagementLeadAuditor", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  closedBy    User?         @relation("EngagementClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("EngagementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("EngagementUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  teamMembers  EngagementTeamMember[]
  findings     Finding[]
  controlTests ControlTest[]
  actionPlans  ActionPlan[]
  evidence     Evidence[]

  @@index([auditPlanId])
  @@index([auditEntityId])
  @@index([riskId])
  @@index([status])
  @@index([type])
  @@index([leadAuditorId])
  @@index([title])
}

enum TeamMemberRole {
  LEAD_AUDITOR
  AUDITOR
  OBSERVER
  SUBJECT_MATTER_EXPERT
  REVIEWER
}

model EngagementTeamMember {
  engagementId String         @db.Uuid
  userId       String         @db.Uuid
  role         TeamMemberRole @default(AUDITOR)
  assignedAt   DateTime       @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user       User       @relation("EngagementTeamMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([engagementId, userId])
  @@index([userId])
}

// ---- Audit Findings ----

enum FindingCategory {
  INTERNAL_CONTROL
  COMPLIANCE
  OPERATIONAL
  FINANCIAL
  IT_GENERAL_CONTROLS
  DATA_QUALITY
  GOVERNANCE
  FRAUD
  OTHER
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  DRAFT
  OPEN
  MANAGEMENT_RESPONSE
  ACTION_PLAN
  REMEDIATED
  VERIFIED
  CLOSED
  CANCELLED
}

model Finding {
  id            String  @id @default(uuid()) @db.Uuid
  reference     String  @unique
  title         String
  engagementId  String? @db.Uuid
  auditEntityId String  @db.Uuid

  category FindingCategory @default(OTHER)
  severity FindingSeverity @default(MEDIUM)
  status   FindingStatus   @default(DRAFT)

  condition               String
  criteria                String?
  cause                   String?
  impact                  String?
  recommendations         String?
  managementResponse      String?
  managementRespondedAt   DateTime?
  managementRespondedById String?   @db.Uuid

  responsibleOwnerId   String?   @db.Uuid
  targetResolutionDate DateTime?

  closedAt          DateTime?
  verifiedAt        DateTime?
  verifiedById      String?   @db.Uuid
  verificationNotes String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement            Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  auditEntity           AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Restrict)
  responsibleOwner      User?         @relation("FindingResponsibleOwner", fields: [responsibleOwnerId], references: [id], onDelete: SetNull)
  managementRespondedBy User?         @relation("FindingManagementResponder", fields: [managementRespondedById], references: [id], onDelete: SetNull)
  verifiedBy            User?         @relation("FindingVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdBy             User?         @relation("FindingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?         @relation("FindingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  controlTests ControlTest[] @relation("ControlTestFinding")
  actionPlans  ActionPlan[]
  evidence     Evidence[]

  @@index([engagementId])
  @@index([auditEntityId])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@index([responsibleOwnerId])
  @@index([targetResolutionDate])
  @@index([title])
}

// ---- Control Testing ----

enum ControlTestStatus {
  PLANNED
  IN_PROGRESS
  TESTED
  REVIEWED
  EXCEPTION
  CANCELLED
}

enum ControlTestOutcome {
  PASS
  FAIL
  PASS_WITH_EXCEPTION
  NOT_APPLICABLE
  INCONCLUSIVE
}

model ControlTest {
  id               String  @id @default(uuid()) @db.Uuid
  reference        String  @unique
  title            String
  engagementId     String? @db.Uuid
  auditEntityId    String? @db.Uuid
  riskId           String? @db.Uuid
  controlReference String?

  status  ControlTestStatus   @default(PLANNED)
  outcome ControlTestOutcome?

  objective         String
  procedures        String
  criteria          String?
  sampleDescription String?
  sampleSize        Int?
  expectedResult    String?
  actualResult      String?
  exceptions        String?
  conclusion        String?
  evidenceReference String?

  testerId    String?   @db.Uuid
  testedAt    DateTime?
  testerNotes String?

  reviewerId    String?   @db.Uuid
  reviewedAt    DateTime?
  reviewerNotes String?

  findingId String? @db.Uuid

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement  Engagement?    @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  auditEntity AuditUniverse? @relation(fields: [auditEntityId], references: [id], onDelete: SetNull)
  risk        Risk?          @relation("ControlTestRisk", fields: [riskId], references: [id], onDelete: SetNull)
  finding     Finding?       @relation("ControlTestFinding", fields: [findingId], references: [id], onDelete: SetNull)
  tester      User?          @relation("ControlTestTester", fields: [testerId], references: [id], onDelete: SetNull)
  reviewer    User?          @relation("ControlTestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("ControlTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?          @relation("ControlTestUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  actionPlans ActionPlan[]
  evidence    Evidence[]

  @@index([engagementId])
  @@index([auditEntityId])
  @@index([riskId])
  @@index([status])
  @@index([outcome])
  @@index([testerId])
  @@index([reviewerId])
  @@index([findingId])
  @@index([title])
}

// ---- Action Plans ----

enum ActionPlanStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ActionPlanPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model ActionPlan {
  id          String @id @default(uuid()) @db.Uuid
  reference   String @unique
  title       String
  description String

  findingId     String? @db.Uuid
  controlTestId String? @db.Uuid
  engagementId  String? @db.Uuid
  auditEntityId String? @db.Uuid

  priority ActionPlanPriority @default(MEDIUM)
  status   ActionPlanStatus   @default(OPEN)

  responsibleOwnerId String? @db.Uuid
  reviewerId         String? @db.Uuid

  targetDate   DateTime?
  completedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid

  managementJustification String?
  proposedRectification   String?
  completionEvidence      String?
  verificationNotes       String?

  progressPct Int @default(0)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finding          Finding?       @relation(fields: [findingId], references: [id], onDelete: SetNull)
  controlTest      ControlTest?   @relation(fields: [controlTestId], references: [id], onDelete: SetNull)
  engagement       Engagement?    @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  auditEntity      AuditUniverse? @relation(fields: [auditEntityId], references: [id], onDelete: SetNull)
  responsibleOwner User?          @relation("ActionPlanResponsibleOwner", fields: [responsibleOwnerId], references: [id], onDelete: SetNull)
  reviewer         User?          @relation("ActionPlanReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  verifiedBy       User?          @relation("ActionPlanVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdBy        User?          @relation("ActionPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?          @relation("ActionPlanUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  updates  ActionPlanUpdate[]
  evidence Evidence[]

  @@index([findingId])
  @@index([controlTestId])
  @@index([engagementId])
  @@index([auditEntityId])
  @@index([status])
  @@index([priority])
  @@index([responsibleOwnerId])
  @@index([targetDate])
  @@index([title])
}

model ActionPlanUpdate {
  id           String   @id @default(uuid()) @db.Uuid
  actionPlanId String   @db.Uuid
  note         String
  progressPct  Int      @default(0)
  updatedById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  actionPlan ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation("ActionPlanUpdateAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([actionPlanId])
  @@index([updatedById])
}

// ---- Evidence Tracker ----

enum EvidenceType {
  WORKING_PAPER
  DOCUMENT
  EMAIL
  SCREENSHOT
  DATA_FILE
  REPORT
  INTERVIEW_NOTE
  MEMO
  OTHER
}

enum EvidenceReviewStatus {
  DRAFT
  IN_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  reference    String       @unique
  title        String
  description  String?
  evidenceType EvidenceType @default(WORKING_PAPER)
  source       String?

  engagementId  String? @db.Uuid
  controlTestId String? @db.Uuid
  findingId     String? @db.Uuid
  actionPlanId  String? @db.Uuid
  auditEntityId String? @db.Uuid

  collectionDate DateTime?

  submittedById  String?              @db.Uuid
  reviewerId     String?              @db.Uuid
  reviewStatus   EvidenceReviewStatus @default(DRAFT)
  reviewComments String?
  reviewedAt     DateTime?

  documentReference String?
  documentMetadata  Json?

  notes String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engagement  Engagement?    @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  controlTest ControlTest?   @relation(fields: [controlTestId], references: [id], onDelete: SetNull)
  finding     Finding?       @relation(fields: [findingId], references: [id], onDelete: SetNull)
  actionPlan  ActionPlan?    @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)
  auditEntity AuditUniverse? @relation(fields: [auditEntityId], references: [id], onDelete: SetNull)
  submittedBy User?          @relation("EvidenceSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewer    User?          @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("EvidenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?          @relation("EvidenceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([engagementId])
  @@index([controlTestId])
  @@index([findingId])
  @@index([actionPlanId])
  @@index([auditEntityId])
  @@index([reviewStatus])
  @@index([evidenceType])
  @@index([submittedById])
  @@index([reviewerId])
  @@index([title])
  @@index([createdById])
  @@index([updatedById])
}
